# ============================================================
# Python Project .gitignore
# VisionAI - SMARTLAB-SU
# ============================================================

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Executable Binaries (*.exe ignored, but track App/.exe/ README & directory)
*.exe
!App/.exe/
!App/.exe/README.md
build/
dist/
*.manifest

# Model Weights & Large Binary Files
*.pth
!Models/
!Models/*.pth
*.pt
*.bin
*.onnx
*.h5
*.tflite
*.engine

# Generated Output Images & Results (Track sample output screenshots)
Output/Output_Imgs/*
!Output/Output_Imgs/.gitkeep
!Output/Output_Imgs/visionai_interface_idle.png
!Output/Output_Imgs/visionai_detection_result.png

# System & Application Logs
logs/
*.log

# Patient Data & Private Information (HIPAA Privacy Compliance)
VisionAI_Patients/
PT-*/
detected_images/
original_images/
recordings/
snapshots/
uploaded_videos/
*.json
result_*.json
report_*.txt

# IDE & OS Metadata
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Jupyter Notebook checkpoints
.ipynb_checkpoints
