# ============================================================
# Python Project .gitignore
# VisionAI - SMARTLAB-SU
# ============================================================

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Executable & Build Artifacts (.exe, build, dist)
*.exe
build/
dist/
*.manifest
*.spec

# Model Weights & Large Binary Files
*.pth
*.pt
*.bin
*.onnx
*.h5
*.tflite
*.engine

# Generated Output Images & Results (keep .gitkeep)
Output/Output_Imgs/*
!Output/Output_Imgs/.gitkeep

# System & Application Logs
logs/
*.log

# Patient Data & Private Information (HIPAA Privacy Compliance)
VisionAI_Patients/
PT-*/
detected_images/
original_images/
recordings/
snapshots/
uploaded_videos/
*.json
result_*.json
report_*.txt

# IDE & OS Metadata
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Jupyter Notebook checkpoints
.ipynb_checkpoints
